{
  "description": "Load the session consensus, guidance and project memory; keep the memory current; report live activity to the Consensus viewer",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"], "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [
      {"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"], "timeout": 5},
      {"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/activity.mjs"], "timeout": 3}
    ]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/activity.mjs"], "timeout": 3}]}],
    "Notification": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/activity.mjs"], "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/activity.mjs"], "timeout": 3}]}],
    "SessionEnd": [{"hooks": [
      {"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"], "timeout": 5},
      {"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/activity.mjs"], "timeout": 3}
    ]}]
  }
}
